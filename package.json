{
  "name": "doormes",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "vite --config apps/designer-web/vite.config.ts",
    "build": "npm run typecheck && vite build --config apps/designer-web/vite.config.ts",
    "build:api": "vite build --config apps/factory-api/vite.config.ts",
    "start:api": "node apps/factory-api/dist/server.js",
    "preview": "vite preview --host 0.0.0.0 --config apps/designer-web/vite.config.ts",
    "capture:legacy-fixtures": "node tools/capture-legacy-bom-fixture.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "verify:legacy-fixtures": "node tools/verify-legacy-bom-fixture.mjs"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "three": "0.186.0"
  },
  "devDependencies": {
    "@types/node": "22.20.3",
    "@types/three": "0.186.0",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  },
  "engines": {
    "node": ">=22"
  }
}
