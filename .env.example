# The local Vite API is the default in development. Set an authenticated API
# base URL for deployment; an empty production value uses IndexedDB offline.
VITE_VISUAL_ASSET_API_BASE_URL=/api

# Relative paths resolve from the DoorMes repository root. Absolute Windows
# paths are also accepted, for example E:/DoorMesData/visual-assets.
DOORMES_VISUAL_ASSET_DIRECTORY=runtime-data/visual-assets

# Development-only identity injected by the local server, never by the browser.
DOORMES_DEV_ACTOR_ID=local-worker

# Factory workflow prototype: file-backed drafts, releases, orders and actuals.
# Relative to the repository root; do not run two server processes against it.
DOORMES_FACTORY_DIRECTORY=runtime-data/factory
# Used only when users.json is created. Existing users are never reset by this.
# Change for LAN testing; then rotate existing accounts in the admin workbench.
DOORMES_PROTOTYPE_PASSWORD=DoorMes-demo-2026!
# Standalone API defaults (dev/preview mount the service under the web origin).
DOORMES_API_HOST=127.0.0.1
DOORMES_API_PORT=5191
